{
  "manifest_version": 3,
  "name": "Before You Copy",
  "version": "1.1.0",
  "description": "A GenAI literacy scaffold that helps students reflect before copying AI-generated output.",
  "permissions": ["storage", "clipboardWrite", "activeTab", "scripting"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*", 
    "https://api.openai.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {"default_popup": "popup.html"},
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
    "css": ["modal.css"],
    "js": [
      "storage.js",
      "llmClient.js",
      "classifier.js",
      "interventions.js",
      "responseEvaluator.js",
      "unlockPolicy.js",
      "contentScript.js"
    ],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["modal.css"],
    "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]
  }]
}
